rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{projectId}/images/{fileName} {
      // 公開讀取圖片（學生指引／問題圖）
      allow read: if true;
      // 僅專案擁有者可上傳（需搭配 Firestore projects.ownerUid）
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
