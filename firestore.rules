rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 老師個人檔（各人只寫自己的檔；專案資料則共用）
    match /teachers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // 共用老師工作區（MVP）：任何已登入 Google 的老師可讀寫所有專案資料。
    // 風險：任何能通過 Auth 的帳號都能改／刪專案；正式環境應改為老師白名單／自訂 claim。
    match /projects/{projectId} {
      // 公開讀取專案設定（學生需知 slug／標題／GPS 範圍）
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn();

      match /locations/{locId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      match /teams/{teamId} {
        // 注意：MVP 允許讀取隊伍（含明文密碼）以便客戶端驗證。
        // 正式環境應改為 Cloud Function 驗證，並禁止客戶端讀 password。
        allow read: if true;
        allow write: if isSignedIn();
      }

      match /submissions/{subId} {
        // Only signed-in teachers (shared workspace). NOT public.
        allow read: if isSignedIn();
        allow create: if true
          && request.resource.data.keys().hasAll(['teamId', 'teamName', 'locationId', 'answers', 'submittedAt']);
        allow update, delete: if isSignedIn();
      }

      match /teamSessions/{teamId} {
        allow read: if true; // 學生／老師皆可讀（MVP）
        allow create, update: if true;
        allow delete: if isSignedIn();
      }
    }
  }
}

/*
  安全注意（請務必閱讀 README）：
  - 本規則為校內 MVP：共用老師工作區（request.auth != null 即可寫）、
    隊伍密碼明文、提交／session 寫入較寬鬆。
  - 公開部署前應：老師電郵／白名單、雜湊密碼、Cloud Functions 驗證、
    收緊 submissions create、限制 teams 讀取欄位、加入 App Check。
*/
